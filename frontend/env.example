# Signaling / backend URL
NEXT_PUBLIC_SIGNALING_SERVER_URL=https://api.emoggle.com

# Supabase — stores the player's display name (Project settings → API).
# Both are safe in the browser: the publishable/anon key carries no
# privileges of its own and every table is guarded by row-level security.
# NEVER put the service_role key in a NEXT_PUBLIC_ variable, or anywhere
# else in this directory — it bypasses RLS entirely.
# Leave both blank to run without a database: the app falls back to
# storing the name in the browser, exactly as it behaved before.
NEXT_PUBLIC_SUPABASE_URL=
# Newer projects issue a publishable key (sb_publishable_...); older ones
# an anon key (a JWT). Set whichever your project shows — the publishable
# one is used when both are present.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI Judge (fashion critic) URL
NEXT_PUBLIC_AI_JUDGE_URL=https://ai.emoggle.com

# Google OAuth Client ID (from Google Cloud Console → Credentials → OAuth 2.0 Client ID)
# Must match the GOOGLE_CLIENT_ID set in signaling-server/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional TURN server for WebRTC (improves connection reliability behind strict NATs)
# NEXT_PUBLIC_TURN_URL=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
