# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Emoggle
DB_USER=postgres
DB_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgresql://postgres:replace_with_a_strong_password@localhost:5432/Emoggle

PORT=3001
NODE_ENV=development

# Comma-separated browser origins allowed to use the signaling service.
FRONTEND_URL=http://localhost:3000

# Internal services and signed webhook authentication. Use independent values.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_JUDGE_URL=http://localhost:8000
AI_JUDGE_SHARED_SECRET=
REVENUECAT_WEBHOOK_SECRET=

# Reverse proxy and abuse controls
TRUST_PROXY_HOPS=1
MAX_CONNECTIONS_PER_IP=8
TRUST_GEO_HEADERS=false

# Keep disabled until scores are calculated entirely from trusted server-side input.
ENABLE_RANKED_ELO=false
