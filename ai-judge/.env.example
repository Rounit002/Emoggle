ENVIRONMENT=development
PORT=8000
JUDGE_MODE=random
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Must exactly match the signaling server's AI_JUDGE_SHARED_SECRET.
AI_JUDGE_SHARED_SECRET=

# The AI service should normally be private. Add exact origins only if needed.
ALLOWED_ORIGINS=
MAX_CONCURRENT_JUDGES=2
FORWARDED_ALLOW_IPS=127.0.0.1
DEBUG_RELOAD=false
