# Signaling / backend URL
NEXT_PUBLIC_SIGNALING_SERVER_URL=https://api.emoggle.com

# AI Judge (fashion critic) URL
NEXT_PUBLIC_AI_JUDGE_URL=https://ai.emoggle.com

# Google OAuth Client ID (from Google Cloud Console → Credentials → OAuth 2.0 Client ID)
# Must match the GOOGLE_CLIENT_ID set in signaling-server/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# RevenueCat Web public SDK key from Project settings → API keys.
# Keep the entitlement identifier in sync with the RevenueCat dashboard.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID=vip

# Optional TURN server for WebRTC (improves connection reliability behind strict NATs)
# NEXT_PUBLIC_TURN_URL=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
